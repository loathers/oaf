{
  "name": "oaf",
  "version": "1.0.0",
  "description": "oaf, the discord bot for the Ascension Speedrun Society",
  "repository": "https://github.com/loathers/oaf",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node --import tsx ./src/index.ts",
    "dev": "DEBUG=true tsx watch ./src/index.ts",
    "format": "prettier --write .",
    "migrate": "kysely migrate:latest",
    "migrate:make": "kysely migrate:make",
    "build": "vite build --config vite.oaf.config.ts && vite build --config vite.calendar.config.ts && vite build --config vite.tulips.config.ts",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@otplib/core": "^13.5.0",
    "@otplib/plugin-base32-alt": "^13.5.0",
    "@otplib/plugin-crypto-node": "^13.5.0",
    "@otplib/totp": "^13.5.0",
    "@types/node": "^25.3.3",
    "@types/serialize-error": "^4.0.1",
    "body-parser": "^2.3.0",
    "convert-svg-to-png": "^0.7.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "data-of-loathing": "4.3.2",
    "date-fns": "^4.4.0",
    "discord.js": "^14.27.0",
    "entities": "^8.1.0",
    "express": "^5.2.1",
    "fast-equals": "^6.0.3",
    "http-status-codes": "^2.3.0",
    "js-sha256": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "kol.js": "^0.14.2",
    "kysely": "^0.29.6",
    "lightstreamer-client-node": "^9.2.2",
    "pg": "^8.23.0",
    "pretty-ms": "^9.3.1",
    "proj4": "^2.22.0",
    "puppeteer": "24.43.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "serialize-error": "^13.0.1",
    "ts-dedent": "^2.3.0",
    "ts-dotenv": "^0.9.1",
    "typescript": "^5.9.3",
    "unidecode": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19",
    "@types/unidecode": "^1.1.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "kysely-ctl": "^0.21.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">= 22.22.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
